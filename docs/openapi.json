  "components": {
    "schemas": {
      "Control": {
        "properties": {
          "action": {
            "type": "string",
            "enum": [
              "start",
              "pause",
              "resume",
              "reset",
              "speed"
            ],
            "title": "Action"
          },
          "speed": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 120.0,
                "minimum": 0.1
              },
              {
                "type": "null"
              }
            ],
            "title": "Speed"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "action"
        ],
        "title": "Control"
      },
      "DemoCommand": {
        "properties": {
          "scenario": {
            "type": "string",
            "enum": [
              "passing",
              "overtaking",
              "priority",
              "closure",
              "empty"
            ],
            "title": "Scenario",
            "default": "passing"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "DemoCommand"
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "IncidentSpec": {
        "properties": {
          "id": {
            "anyOf": [
              {
                "type": "string",
                "pattern": "^[A-Za-z0-9_-]{1,48}$"
              },
              {
                "type": "null"
              }
            ],
            "title": "Id"
          },
          "kind": {
            "type": "string",
            "enum": [
              "train_delay",
              "train_breakdown",
              "signal_failure",
              "track_closure",
              "speed_restriction"
            ],
            "title": "Kind"
          },
          "asset_type": {
            "type": "string",
            "enum": [
              "train",
              "signal",
              "station",
              "switch",
              "edge"
            ],
            "title": "Asset Type"
          },
          "asset_id": {
            "type": "string",
            "maxLength": 48,
            "minLength": 1,
            "title": "Asset Id"
          },
          "start_s": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Start S"
          },
          "duration_s": {
            "anyOf": [
              {
                "type": "number",
                "maximum": 86400.0,
                "minimum": 1.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration S",
            "default": 120
          },
          "speed_kmh": {
            "type": "number",
            "maximum": 160.0,
            "minimum": 5.0,
            "title": "Speed Kmh",
            "default": 20
          },
          "note": {
            "type": "string",
            "maxLength": 300,
            "title": "Note",
            "default": ""
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "kind",
          "asset_type",
          "asset_id"
        ],
        "title": "IncidentSpec"
      },
      "IngestEvent": {
        "properties": {
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,32}$",
            "title": "Source"
          },
          "sequence": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Sequence"
          },
          "sim_time": {
            "type": "number",
            "minimum": 0.0,
            "title": "Sim Time"
          },
          "incident": {
            "$ref": "#/components/schemas/IncidentSpec"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "source",
          "sequence",
          "sim_time",
          "incident"
        ],
        "title": "IngestEvent"
      },
      "Login": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 32,
            "minLength": 1,
            "title": "Username"
          },
          "password": {
            "type": "string",
            "maxLength": 200,
            "minLength": 1,
            "title": "Password"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "username",
          "password"
        ],
        "title": "Login"
      },
      "Settings": {
        "properties": {
          "weights": {
            "$ref": "#/components/schemas/Weights"
          },
          "normal_threshold": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Normal Threshold",
            "default": 80
          },
          "attention_threshold": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 0.0,
            "title": "Attention Threshold",
            "default": 55
          },
          "simulation_speed": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 0.1,
            "title": "Simulation Speed",
            "default": 30
          },
          "clearance_m": {
            "type": "number",
            "maximum": 100.0,
            "minimum": 10.0,
            "title": "Clearance M",
            "default": 25
          },
          "signal_block_m": {
            "type": "number",
            "maximum": 5000.0,
            "minimum": 500.0,
            "title": "Signal Block M",
            "default": 2000
          },
          "authority_lookahead_m": {
            "type": "number",
            "maximum": 20000.0,
            "minimum": 1000.0,
            "title": "Authority Lookahead M",
            "default": 5000
          },
          "starvation_s": {
            "type": "number",
            "maximum": 3600.0,
            "minimum": 30.0,
            "title": "Starvation S",
            "default": 300
          },
          "retention_hours": {
            "type": "integer",
            "maximum": 72.0,
            "minimum": 24.0,
            "title": "Retention Hours",
            "default": 48
          },
          "quality_window_s": {
            "type": "integer",
            "maximum": 900.0,
            "minimum": 60.0,
            "title": "Quality Window S",
            "default": 300
          },
          "random_incidents_per_hour": {
            "type": "number",
            "maximum": 120.0,
            "minimum": 0.0,
            "title": "Random Incidents Per Hour",
            "default": 0
          },
          "random_seed": {
            "type": "integer",
            "maximum": 2147483647.0,
            "minimum": 0.0,
            "title": "Random Seed",
            "default": 42
          },
          "terminal_release_s": {
            "type": "number",
            "maximum": 600.0,
            "minimum": 1.0,
            "title": "Terminal Release S",
            "default": 30
          }
        },
        "additionalProperties": false,
        "type": "object",
        "title": "Settings"
      },
      "Stop": {
        "properties": {
          "vertex": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Vertex"
          },
          "dwell_s": {
            "type": "number",
            "maximum": 7200.0,
            "minimum": 0.0,
            "title": "Dwell S",
            "default": 30
          },
          "scheduled_arrival_s": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Scheduled Arrival S"
          }
        },
        "additionalProperties": false,
        "type": "object",
        "required": [
          "vertex"
        ],
        "title": "Stop"
      },
      "TrainSpec": {
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9_-]{1,24}$",
            "title": "Id"
          },
          "name": {
            "type": "string",
            "maxLength": 80,
            "minLength": 1,
            "title": "Name"
          },
          "origin": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Origin"
          },
          "destination": {
            "type": "integer",
            "minimum": 0.0,
            "title": "Destination"
          },
          "departure_s": {
            "type": "number",
            "minimum": 0.0,
            "title": "Departure S",
            "default": 0
          },
          "scheduled_arrival_s": {
            "anyOf": [
              {
                "type": "number",
                "minimum": 0.0
