DEMO_MODE=true
RETENTION_HOURS=48
# Set DEMO_MODE=false and provide all three passwords to enforce role login.
VIEWER_PASSWORD=
DISPATCHER_PASSWORD=
ADMIN_PASSWORD=
# Enable for HTTPS deployments.
COOKIE_SECURE=false
# run_local.py generates a private service token when this is empty.
# Docker Compose requires you to set a random token explicitly.
INGESTION_TOKEN=
# Bare uvicorn supports embedded normalization; run_local.py/Compose use remote.
INGESTION_MODE=embedded
