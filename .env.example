DEMO_MODE=false
RETENTION_HOURS=48
# Generate local role passwords with: python scripts/setup_local.py
VIEWER_PASSWORD=
DISPATCHER_PASSWORD=
ADMIN_PASSWORD=
# Enable for HTTPS deployments.
COOKIE_SECURE=false

# logic: 13-station multi-track engine; demo: original 6-station simulator
DISPATCH_ENGINE=logic

# Separate local ingestion process (run_local.py starts both services).
INGEST_URL=http://127.0.0.1:8001
INGEST_TOKEN=
